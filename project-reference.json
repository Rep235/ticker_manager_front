    "docs/ai/": "Contratos y reglas obligatorias"
  },
  "mandatory_rules": {
    "no_custom_css": "Solo Tailwind CSS",
    "no_inline_styles": "Usar className solo",
    "strict_typescript": "No any types (usar getErrorMessage)",
    "component_structure": "components/ui es componentes base, features tiene lógica",
